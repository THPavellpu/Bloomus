# Local development defaults. Do not put production secrets in this file.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Set DATABASE_URL on Render using the PostgreSQL Internal Database URL.
# When DATABASE_URL is absent, these settings keep SQLite as the local default.
# DB_ENGINE may be set to "postgresql" with the DB_* variables for non-Render use.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional deployment-standard names supported by config/settings.py:
# SECRET_KEY=
# DEBUG=False
# ALLOWED_HOSTS=
# CSRF_TRUSTED_ORIGINS=
